# Copy to deploy/deploy.env (gitignored) and fill in your own values.
# scripts/deploy.sh sources this to learn where it is deploying to, and
# renders deploy/Caddyfile.template with it. Site-local names stay out of
# version control — they are nobody else's business, and a public clone
# should not describe someone's home network.

# SSH user on the target.
PI_USER="${PI_USER:-pi}"

# Short hostname. Also the basename of the mkcert files in deploy/tls/,
# i.e. deploy/tls/$PI_NAME.pem and deploy/tls/$PI_NAME-key.pem.
PI_NAME="${PI_NAME:-raspberrypi}"

# Fully-qualified name your router hands out for it.
PI_FQDN="${PI_FQDN:-raspberrypi.lan}"

# Its LAN address. Must match the mkcert SAN list (ADR 0014).
PI_LAN_IP="${PI_LAN_IP:-192.0.2.10}"

# Optional: SSH key, defaults to ~/.ssh/cairn_pi
#PI_KEY=$HOME/.ssh/cairn_pi
